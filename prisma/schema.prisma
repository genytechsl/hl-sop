generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id           String   @id
  name         String
  designation  String
  email        String   @unique
  active       Boolean  @default(true)
  role         String
  username     String   @unique
  passwordHash String   @map("password_hash")
  department   String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedTickets Ticket[]       @relation("TicketAssignee")
  updatedRemarks  TicketRemark[] @relation("RemarkUpdater")

  @@map("employees")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  head        String
  email       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Customer {
  id        String   @id
  name      String
  email     String
  mobile    String
  nic       String   @map("nic")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties CustomerProperty[]
  tickets    Ticket[]

  @@index([name])
  @@index([email])
  @@index([nic])
  @@map("customers")
}

model CustomerProperty {
  id           Int      @id @default(autoincrement())
  customerId   String   @map("customer_id")
  propertyName String   @map("property_name")
  address      String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([customerId, propertyName])
  @@index([customerId])
  @@map("customer_properties")
}

model Ticket {
  id              String   @id
  title           String
  description     String

  ticketType      String   @map("ticket_type")
  category        String
  categoryLabel   String   @map("category_label")
  status          String
  priority        String

  customerId      String   @map("customer_id")
  propertyId      Int      @map("property_id")
  assignedToId    String?  @map("assigned_to_id")

  slaTarget       String   @map("sla_target")
  complaintSource String   @map("complaint_source")
  scope           String

  cctoList        Json     @default("[]") @map("ccto_list")
  sendEmail       Boolean  @default(false) @map("send_email")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  property   CustomerProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  assignedTo Employee?        @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  remarks         TicketRemark[]
  slaNotification TicketSlaNotification?
  attachments     TicketAttachment[]

  @@index([customerId])
  @@index([propertyId])
  @@index([assignedToId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@map("tickets")
}

model TicketTypeScope {
  id         Int    @id @default(autoincrement())
  ticketType String @map("ticket_type")
  scope      String

  @@unique([ticketType, scope])
  @@index([ticketType])
  @@map("ticket_type_scopes")
}

model TicketCategory {
  id       Int    @id @default(autoincrement())
  code     String @unique
  label    String
  sla      String
  priority String

  @@index([label])
  @@map("ticket_categories")
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String   @map("ticket_id")
  originalName String   @map("original_name")
  storedName   String   @map("stored_name")
  filePath     String   @map("file_path")
  mimeType     String   @map("mime_type")
  fileSize     Int      @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketRemark {
  id              Int      @id @default(autoincrement())
  ticketId        String   @map("ticket_id")
  remarkType      String   @map("remark_type")
  statusChangedTo String?  @map("status_changed_to")
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedById     String   @map("updated_by")

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  updatedBy Employee @relation("RemarkUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([updatedById])
  @@index([createdAt])
  @@map("ticket_remarks")
}
model TicketSlaNotification {
  id            Int      @id @default(autoincrement())
  ticketId      String   @unique @map("ticket_id")
  warning80Sent Boolean  @default(false) @map("warning_80_sent")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_sla_notifications")
}

model ReportScheduler {
  id        String   @id
  email     String
  report    String
  frequency String
  day       Int?
  time      String
  active    Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([frequency])
  @@map("report_schedulers")
}
